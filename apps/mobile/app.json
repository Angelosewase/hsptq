{
  "expo": {
    "name": "CareQueue",
    "slug": "carequeue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "carequeue",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.carequeue.app",
      "infoPlist": {
        "NSCameraUsageDescription": "CareQueue uses the camera to scan QR codes for hospital check-in."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00685F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.carequeue.app",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "CareQueue needs camera access to scan hospital QR codes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00685F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
